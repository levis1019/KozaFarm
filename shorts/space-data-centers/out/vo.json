 "uebereinstimmung": 0.991,
 "lines": [
  {
   "i": 0,
   "text": "Google just launched AI chips into orbit.",
   "start": 0.56,
   "end": 3.37
  },
  {
   "i": 1,
   "text": "The reason is power.",
   "start": 3.37,
   "end": 4.7
  },
  {
   "i": 2,
   "text": "It's a test for data centers in space: one satellite, four AI chips.",
   "start": 4.7,
   "end": 10.03
  },
  {
   "i": 3,
   "text": "In that orbit, the sun almost never sets,",
   "start": 10.03,
   "end": 12.45
  },
  {
   "i": 4,
   "text": "so the panels make up to eight times more power than on Earth.",
   "start": 12.45,
   "end": 16.09
  },
  {
   "i": 5,
   "text": "The catch? Heat.",
   "start": 16.09,
   "end": 17.512
  },
  {
   "i": 6,
   "text": "There's no air to carry it off, so the chips run about fifteen minutes, then rest.",
   "start": 17.512,
   "end": 22.223
  },
  {
   "i": 7,
   "text": "Didn't expect this: a startup already ran Google's own AI up there.",
   "start": 22.223,
   "end": 27.24
  },
  {
   "i": 8,
   "text": "My take? Genius idea, insane timeline.",
   "start": 27.24,
   "end": 30.515
  },
  {
   "i": 9,
   "text": "Google's own project lead told NPR he doesn't expect it to get cheaper for five years.",
   "start": 30.515,
   "end": 36.32
  },
  {
   "i": 10,
   "text": "So, genius or insane?",
   "start": 36.32,
   "end": 38.285
  }
 ],
