 "uebereinstimmung": 0.981,
 "lines": [
  {
   "i": 0,
   "text": "U.S. diesel just hit a record.",
   "start": 0.32,
   "end": 2.74
  },
  {
   "i": 1,
   "text": "Now China's paused its fuel exports.",
   "start": 2.74,
   "end": 5.22
  },
  {
   "i": 2,
   "text": "Its big refiners stopped selling abroad for October.",
   "start": 5.22,
   "end": 8.26
  },
  {
   "i": 3,
   "text": "China's own fuel stocks are low.",
   "start": 8.26,
   "end": 10.76
  },
  {
   "i": 4,
   "text": "And the world was already short.",
   "start": 10.76,
   "end": 13.13
  },
  {
   "i": 5,
   "text": "War in the Middle East.",
   "start": 13.13,
   "end": 14.33
  },
  {
   "i": 6,
   "text": "Russia's holding back diesel.",
   "start": 14.33,
   "end": 16.55
  },
  {
   "i": 7,
   "text": "Diesel moves your food and almost everything else.",
   "start": 16.55,
   "end": 19.41
  },
  {
   "i": 8,
   "text": "Trucks, ships, tractors.",
   "start": 19.41,
   "end": 21.223
  },
  {
   "i": 9,
   "text": "Here's my take: China's fuel doesn't have to reach you.",
   "start": 21.223,
   "end": 25.157
  },
  {
   "i": 10,
   "text": "It's one world pool.",
   "start": 25.157,
   "end": 27.34
  },
  {
   "i": 11,
   "text": "A seller steps out, everyone bids up the rest.",
   "start": 27.34,
   "end": 30.72
  },
  {
   "i": 12,
   "text": "Watch October seventh, when China's holiday ends.",
   "start": 30.72,
   "end": 33.64
  },
  {
   "i": 13,
   "text": "Nobody knows if exports restart.",
   "start": 33.64,
   "end": 36.22
  },
  {
   "i": 14,
   "text": "Pump or groceries: where would you notice first?",
   "start": 36.33,
   "end": 39.011
  }
 ],
